# Browser-facing website address, without a trailing slash.
WPL_PUBLIC_URL=http://localhost:8080

# Compose's internal web listener. HTTPS deployments terminate TLS externally.
WPL_LISTEN_ADDRESS=127.0.0.1
WPL_HTTP_PORT=8080

# Local development overrides.
# For a single-address deployment, omit these:
# API defaults to WPL_PUBLIC_URL/api; GUI defaults to WPL_PUBLIC_URL.
# WPL_API_BASE_URL=http://localhost:8000
# WPL_GUI_BASE_URL=http://localhost:8080

# SQLite file: absolute path or relative to the repository root.
WPL_DATABASE_PATH=data/wpl.db

# Same Supabase project as the frontend.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Backend only: required for account lookup.
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# GitHub App credentials. Use Client ID, not App ID.
WPL_GITHUB_CLIENT_ID=YOUR_CLIENT_ID
WPL_GITHUB_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Generate once per installation and preserve across restarts.
WPL_SECRET_KEY=YOUR_GENERATED_SIGNING_SECRET

# Student container settings.
WPL_LAB_IMAGE=wpl-student:dev
WPL_LAB_MEMORY=1g
WPL_LAB_CPUS=0.25
WPL_LAB_PIDS_LIMIT=256
WPL_IDLE_MINUTES=30
